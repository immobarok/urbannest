	async getUnavailableDates(listingId: string) {
		const bookings = await this.prisma.booking.findMany({
			where: {
				listingId,
				status: {
					in: [BookingStatus.CONFIRMED, BookingStatus.PENDING], // Block pending too to prevent double booking attempts
				},
				checkOut: {
					gte: new Date(), // Only future bookings matter
				},
			},
			select: {
				checkIn: true,
				checkOut: true,
			},
		});

		return bookings.map((booking) => ({
			checkIn: booking.checkIn,
			checkOut: booking.checkOut,
		}));
	}
